# Generate a unique random local operator credential before running.
# NEVER commit a real token or wallet secret.
OPERATOR_ACCESS_TOKEN=replace_with_your_own_random_32_character_token
POLICY_DISALLOW_SPEND=true

# Hard-disabled by default. Do not change without separate explicit spending approval.
LIVE_BUY_MODE=DISABLED
BUY_ACCOUNT_NAME=celo-open-rails
# BUY_CLI_ENTRY=/absolute/path/to/installed/@celo/buy/dist/main.js

# Private, server-side Hermes Agent reasoning via an SSH tunnel on the operator machine.
# Never expose Hermes directly to the browser or public internet: it is a privileged runtime.
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=replace_with_private_vps_api_server_key
HERMES_MODEL=hermes-agent
HERMES_REQUIRED=true
HERMES_ALLOW_DETERMINISTIC_FALLBACK=false

# Legacy providers are not used while Hermes is configured.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# BUY_HOME=
